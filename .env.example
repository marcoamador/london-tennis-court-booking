# Copy to .env and fill in. Never commit .env.

# Public hostname. sslip.io maps 94-130-138-168.sslip.io -> 94.130.138.168 so Caddy can get an HTTPS cert.
SITE_HOST=94-130-138-168.sslip.io
BASE_URL=https://94-130-138-168.sslip.io

# Long random string: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# The admin can sign in and invite friends.
ADMIN_EMAIL=you@example.com

# Gmail SMTP: create an app password at https://myaccount.google.com/apppasswords (needs 2-step verification).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=
MAIL_FROM=CourtWatch <you@gmail.com>

# Polling
POLL_SECONDS=300
DAYS_AHEAD=14
# Shown in the User-Agent so venues can reach you if polling ever bothers them.
CONTACT_EMAIL=you@example.com

# Victoria Park (Courtside): leave disabled; see docs/courtside.md
COURTSIDE_ENABLED=false
