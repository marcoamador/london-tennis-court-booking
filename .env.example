# CourtWatch configuration. Copy to .env and fill in. Never commit .env.
# Every app setting is listed here. Anything left empty or commented out uses the default shown.

# ── Required in production ───────────────────────────────────────────────────

# Public URL of the app, including any subpath. Used in sign-in and alert email links.
#   subpath behind nginx:  https://your-host/tennis
#   own hostname:          https://94-130-138-168.sslip.io
BASE_URL=https://94-130-138-168.sslip.io

# Long random string that signs sessions and email links. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start with the default when BASE_URL is https.
SECRET_KEY=change-me

# This person can sign in and invite friends from /admin.
ADMIN_EMAIL=you@example.com

# ── Email (Gmail SMTP) ───────────────────────────────────────────────────────
# Needs a Gmail app password: https://myaccount.google.com/apppasswords (2-step verification required).
# If SMTP_PASSWORD is empty, emails are only printed to the log ("console mode").
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=
MAIL_FROM=CourtWatch <you@gmail.com>
# Force console mode even when SMTP is configured (local development).
MAIL_CONSOLE=false

# ── Serving under a subpath ──────────────────────────────────────────────────
# e.g. /tennis when nginx forwards https://your-host/tennis/ to the app. Empty = served at the root.
# BASE_URL must then include the same subpath.
ROOT_PATH=

# ── Polling and alerts (optional) ────────────────────────────────────────────
POLL_ENABLED=true
# Seconds between availability checks. Please keep this at 300 or more to be polite to the venues.
POLL_SECONDS=300
# How many days ahead to track.
DAYS_AHEAD=14
# Don't alert about slots starting sooner than this many minutes from now.
MIN_LEAD_MINUTES=30
# Sent in the User-Agent so venues can contact you if polling ever bothers them.
CONTACT_EMAIL=you@example.com

# ── Victoria Park / Courtside (keep disabled; see docs/courtside.md) ─────────
COURTSIDE_ENABLED=false
COURTSIDE_EMAIL=
COURTSIDE_PASSWORD=

# ── Storage ──────────────────────────────────────────────────────────────────
# SQLite file. docker-compose.yml sets this to /data/courtwatch.db (a Docker volume), so you only
# need it when running outside Docker.
DATABASE_PATH=data/courtwatch.db

# ── Docker Compose / proxy only (not read by the app) ────────────────────────
# Port the app binds on 127.0.0.1 for the host's reverse proxy (nginx) to forward to.
APP_PORT=8000
# Only for the optional bundled Caddy proxy, on a server with nothing on ports 80/443:
# COMPOSE_PROFILES=caddy
# SITE_HOST=94-130-138-168.sslip.io
